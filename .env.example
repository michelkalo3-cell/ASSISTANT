# CHARAMOU AI - Variables d'environnement
# Copiez ce fichier en .env et renseignez vos clés API

# ── IA ────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Services météo ────────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=...

# ── Actualités ────────────────────────────────────────────────────────────────
NEWS_API_KEY=...

# ── Wake word Porcupine (optionnel) ───────────────────────────────────────────
PORCUPINE_ACCESS_KEY=...

# ── Sécurité ──────────────────────────────────────────────────────────────────
SECRET_KEY=changez_cette_valeur_en_production
