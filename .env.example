# CHARAMOU AI - Variables d'environnement
# Copiez ce fichier en .env et renseignez vos clés API

# ── IA ────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Services météo ────────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=...

# ── Actualités ────────────────────────────────────────────────────────────────
NEWS_API_KEY=...

# ── Spotify ───────────────────────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=votre_id_client
SPOTIFY_CLIENT_SECRET=votre_secret_client
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# ── Wake word Porcupine (optionnel) ───────────────────────────────────────────
PORCUPINE_ACCESS_KEY=...

# ── Sécurité ──────────────────────────────────────────────────────────────────
SECRET_KEY=changez_cette_valeur_en_production
